#!/usr/bin/env bash
set -euo pipefail

# Git exports repository-local variables to hooks. Nested Git or task runners
# must resolve the worktree they actually run in, not inherit Git's hook state.
# CARGO_TARGET_DIR joins the list for the same reason: an inherited value would
# override mise's per-worktree default and let a sibling worktree's artifacts
# answer this gate (TASK-179).
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE \
  GIT_OBJECT_DIRECTORY GIT_NAMESPACE CARGO_TARGET_DIR

exec mise run fmt
