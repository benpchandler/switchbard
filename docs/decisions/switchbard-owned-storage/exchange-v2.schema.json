{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switchbard.local/schema/exchange-v2.json",
  "title": "Switchbard exchange v2",
  "description": "Current implemented envelope. Raw document fields remain extensible. See exchange-v2.md for byte/depth/digest/native graph constraints not expressible in JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "repo_id",
    "epoch_id",
    "kinds",
    "records",
    "digest"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "repo_id": {
      "$ref": "#/$defs/uuid"
    },
    "epoch_id": {
      "$ref": "#/$defs/uuid"
    },
    "kinds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "records": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "data"
          ],
          "properties": {
            "encoding": {
              "const": "utf8-lines"
            },
            "data": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\n]*(?:\\n)?$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "data"
          ],
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "data": {
              "type": "string",
              "contentEncoding": "base64",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      ]
    },
    "clock": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locator",
        "content",
        "deleted",
        "clock"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]+$"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "deleted": {
          "type": "boolean"
        },
        "clock": {
          "$ref": "#/$defs/clock"
        },
        "content_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 1,
          "description": "Per-kind payload version. Version1 is omitted in canonical output; unsupported versions remain opaque."
        }
      }
    }
  }
}
